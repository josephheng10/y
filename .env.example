# Everything is OPTIONAL. With no env vars the app runs on demo seed data.

# --- Auth.js / NextAuth ---
# Email + password works with no keys. Accounts are stored in .data/users.json.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=            # openssl rand -base64 32  (required in production)

# Google (Gmail, read-only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft (Outlook / Yale M365 via Graph Mail.Read)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common   # or Yale's tenant id if Yale IT registers the app

# Extra listserv sender substrings (comma-separated), on top of List-Id/List-Unsubscribe detection
LISTSERV_SENDERS=panlist,@yaleconnect.yale.edu,listserv.yale.edu

# --- Storage (Supabase). If unset → in-memory + .data/items.json ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=  # server-only, never expose to the browser

# --- AI tagger: any OpenAI-compatible /chat/completions endpoint ---
# If LLM_API_KEY is unset → offline keyword tagger.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- YaleConnect: iCal feed URL(s), comma-separated ---
YALECONNECT_ICAL_URL=

# --- Ingest protection (Fizz / manual / YaleConnect POSTs). Send as header x-ingest-secret ---
INGEST_SECRET=

# Show fictional demo items alongside real ones (default true). Set false for real launch.
SEED_DEMO=true
